{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend-first e-commerce platform scaffold built with NestJS, Supabase, Prisma, and Vercel Blob.",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "build": "prisma generate && nest build",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:e2e": "jest test",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:test": "npx ts-node src/scripts/test-db.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:setup": "prisma generate && prisma migrate dev",
    "db:clone": "npx ts-node src/scripts/clone-remote-db.ts"
  },
  "keywords": [
    "nestjs",
    "supabase",
    "vercel",
    "ecommerce",
    "backend"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/testing": "^11.2.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "7.9.1",
    "@supabase/supabase-js": "^2.112.3",
    "@vercel/blob": "^2.8.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "date-fns": "^4.4.0",
    "dotenv": "^16.6.1",
    "jwt-decode": "^4.0.0",
    "pg": "^8.23.0",
    "prisma": "7.9.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "shared": "*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "npx ts-node prisma/seed.ts"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
