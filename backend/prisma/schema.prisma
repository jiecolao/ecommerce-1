generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  products     Product[]
  orders       Order[]
}

model Product {
  id             String        @id @default(cuid())
  sellerId       String
  title          String
  description    String
  priceCents     Int
  inventoryCount Int
  isFeatured     Boolean       @default(false)
  status         ProductStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  seller         User          @relation(fields: [sellerId], references: [id])
  images         ProductImage[]
  orderItems     OrderItem[]

  @@index([sellerId])
  @@index([isFeatured])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  blobUrl   String
  altText   String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Order {
  id               String        @id @default(cuid())
  buyerId          String
  status           OrderStatus   @default(PENDING_PAYMENT)
  subtotalCents    Int
  shippingCents    Int
  totalCents       Int
  paymentReference String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  buyer            User          @relation(fields: [buyerId], references: [id])
  items            OrderItem[]
  invoice          Invoice?

  @@index([buyerId])
  @@index([createdAt])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  productId      String
  quantity       Int
  unitPriceCents Int
  lineTotalCents Int
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Invoice {
  id           String   @id @default(cuid())
  orderId      String   @unique
  invoiceNo    String   @unique
  issuedAt     DateTime @default(now())
  billingName  String
  billingEmail String
  notes        String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  FULFILLING
  COMPLETE
  CANCELLED
}
