{
  "version": 2,
  "builds": [
    {
      "src": "backend/api/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/backend/api/index.ts" },
    { "source": "/assets/(.*)", "destination": "/frontend/assets/$1" },
    { "source": "/favicon.svg", "destination": "/frontend/favicon.svg" },
    { "source": "/icons.svg", "destination": "/frontend/icons.svg" },
    { "source": "/image.png", "destination": "/frontend/image.png" },
    { "source": "/palworld-cover.jpg", "destination": "/frontend/palworld-cover.jpg" },
    { "source": "/palworld.png", "destination": "/frontend/palworld.png" },
    { "source": "/(.*\\.(?:ico|png|jpg|jpeg|svg|webp|gif|json|txt|woff2|woff|ttf|eot))", "destination": "/frontend/$1" },
    { "source": "/(.*)", "destination": "/frontend/index.html" }
  ],
  "env": {
    "NODE_OPTIONS": "--experimental-require-module"
  }
}
